{
  "name": "coffee-cherry-helpdesk-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3002",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0 --port 3002",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "http-status-codes": "^2.3.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^16.7.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "sass": "1.83.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
